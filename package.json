{
  "name": "deepseek-weather-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal TypeScript agent loop with DeepSeek and one current-weather tool",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "pnpm build && node --env-file-if-exists=.env dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
